# E-SMART360 / BotSailor
BS_API_TOKEN=replace_me
BS_BASE_URL=https://app.e-smart360.com
BS_PHONE_NUMBER_ID_DR=replace_me
BS_PHONE_NUMBER_ID_DRA=replace_me

# Cal.com
CALCOM_API_KEY=replace_me
CALCOM_WEBHOOK_SECRET_DR=replace_me
CALCOM_WEBHOOK_SECRET_DRA=replace_me
ALLOW_INSECURE_CALCOM_WEBHOOKS=true

# Security
INTERNAL_API_KEY=replace_me

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# App
APP_ENV=development
APP_PORT=8080
